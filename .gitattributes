# Repo is edited on macOS and Windows: store and check out text files with LF everywhere.
* text=auto eol=lf

# Unity YAML (force text so CRLF never sneaks in)
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.physicmaterial text eol=lf
*.lighting text eol=lf
*.inputactions text eol=lf
*.shadergraph text eol=lf

# Code / shaders / docs
*.cs text eol=lf diff=csharp
*.asmdef text eol=lf
*.shader text eol=lf
*.hlsl text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.tss text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.tif binary
*.tga binary
*.psd binary
*.exr binary
*.hdr binary
*.fbx binary
*.obj binary
*.wav binary
*.ogg binary
*.mp3 binary
*.webm binary
*.mp4 binary
*.ttf binary
*.otf binary
*.bytes binary
*.wlt binary
*.dll binary
*.so binary
*.dylib binary
*.lib binary
*.exe binary
